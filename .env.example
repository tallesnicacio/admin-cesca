# ===================================
# Admin CESCA - Variáveis de Ambiente
# ===================================

# O frontend usa a API própria em /api. Para forçar o modo PDV localmente:
# VITE_APP_MODE=pdv

# Docker Configuration (para deploy)
DOCKER_REGISTRY=localhost:5000
VERSION=latest

# ===================================
# INSTRUÇÕES
# ===================================
# 1. Copie este arquivo: cp .env.example .env
# 2. Para desenvolvimento: npm start
# 3. Para build: npm run build
